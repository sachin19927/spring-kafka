{
  "type": "record",
  "name": "Order",
  "namespace": "com.spring.poc.kafka.events",
  "doc": "Represents an order as it moves through the init -> process -> alert pipeline. The status field is updated and re-published at each stage of the lifecycle.",
  "fields": [
    { "name": "orderId", "type": "string", "doc": "Unique identifier for the order, generated by order-init." },
    { "name": "customerId", "type": "string", "doc": "Identifier of the customer who placed the order." },
    { "name": "product", "type": "string", "doc": "Name/SKU of the product ordered." },
    { "name": "quantity", "type": "int", "doc": "Quantity ordered." },
    { "name": "amount", "type": "double", "doc": "Total order amount." },
    {
      "name": "status",
      "doc": "Current lifecycle status of the order.",
      "type": {
        "type": "enum",
        "name": "OrderStatus",
        "symbols": ["CREATED", "PROCESSING", "COMPLETED", "FAILED"]
      }
    },
    { "name": "message", "type": ["null", "string"], "default": null, "doc": "Human readable detail, e.g. failure reason." },
    { "name": "createdTimestamp", "type": ["null", "long"], "default": null, "doc": "Epoch millis when the order was first created." },
    { "name": "updatedTimestamp", "type": ["null", "long"], "default": null, "doc": "Epoch millis when the status was last updated." }
  ]
}
